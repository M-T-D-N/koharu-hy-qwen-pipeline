+async fn mcp(State(handle): State<AppHandle<Cef>>, Json(request): Json<McpRequest>) -> Response {
+    if request.method == "notifications/initialized" {
+        return StatusCode::ACCEPTED.into_response();
+    }
+    let id = request.id.unwrap_or(Value::Null);
+    let result = match request.method.as_str() {
+        "initialize" => Ok(json!({
+            "protocolVersion": MCP_LEGACY_VERSION,
+            "capabilities": { "tools": { "listChanged": false } },
+            "serverInfo": { "name": "koharu-local", "version": env!("CARGO_PKG_VERSION") },
+            "instructions": "Use Koharu tools to manage the active local manga project."
+        })),
+        "server/discover" => Ok(json!({
+            "protocolVersion": MCP_PROTOCOL_VERSION,
+            "capabilities": { "tools": {} },
+            "serverInfo": { "name": "koharu-local", "version": env!("CARGO_PKG_VERSION") }
+        })),
+        "ping" => Ok(json!({})),
+        "tools/list" => Ok(json!({ "tools": mcp_tools() })),
+        "tools/call" => mcp_call(&handle, request.params).await,
+        method => Err(ApiError::bad_request(format!(
+            "unsupported MCP method {method:?}"
+        ))),
+    };
+    match result {
+        Ok(result) => Json(json!({ "jsonrpc": "2.0", "id": id, "result": result })).into_response(),
+        Err(error) if request.method == "tools/call" => Json(json!({
+            "jsonrpc": "2.0",
+            "id": id,
+            "result": {
+                "content": [{ "type": "text", "text": error.message }],
+                "isError": true
+            }
+        }))
+        .into_response(),
+        Err(error) => Json(json!({
+            "jsonrpc": "2.0",
+            "id": id,
+            "error": { "code": -32602, "message": error.message }
+        }))
+        .into_response(),
+    }
+}
+
+async fn mcp_call(handle: &AppHandle<Cef>, params: Value) -> std::result::Result<Value, ApiError> {
+    let name = params
+        .get("name")
+        .and_then(Value::as_str)
+        .context("MCP tools/call requires params.name")
+        .map_err(ApiError::bad_request)?;
+    let arguments = params
+        .get("arguments")
+        .cloned()
+        .unwrap_or_else(|| json!({}));
+    let structured = match name {
+        "koharu_status" => json!({
+            "health": health_value(handle),
+            "project": lifecycle::get_project(handle.state()).await?,
+            "jobs": job_values(handle),
+        }),
+        "list_projects" => json!({
+            "projects": lifecycle::list_projects(handle.state()).await?
+        }),
+        "create_project" => {
+            let request: NameRequest = decode(arguments)?;
+            lifecycle::create_project(request.name, handle.clone()).await?;
+            json!({ "created": true })
+        }
+        "open_project" => {
+            let request: NameRequest = decode(arguments)?;
+            lifecycle::open_project(request.name, handle.clone()).await?;
+            json!({ "opened": true })
+        }
+        "current_project" => {
+            let project = lifecycle::get_project(handle.state()).await?;
+            let pages = if project.is_some() {
+                lifecycle::get_pages(handle.state()).await?
+            } else {
+                Vec::new()
+            };
+            json!({ "project": project, "pages": pages })
+        }
+        "page_scene" => {
+            let request: SelectPageRequest = decode(arguments)?;
+            json!({ "page": load_page(handle, request.page).await? })
+        }
+        "import_pages" => {
+            let request: ImportRequest = decode(arguments)?;
+            lifecycle::import_page_paths(
+                request.paths,
+                handle.state(),
+                handle.state(),
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "imported": true })
+        }
+        "run_pipeline" => {
+            let request: ProcessRequest = decode(arguments)?;
+            handle
+                .state::<Initialization>()
+                .wait()
+                .await
+                .map_err(ApiError::internal)?;
+            let job = processing::process(
+                handle.clone(),
+                request.scope,
+                request.operation,
+                handle.state(),
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "job": job })
+        }
+        "jobs" => json!({ "jobs": job_values(handle) }),
+        "set_source_text" => {
+            let request: SourceTextRequest = decode(arguments)?;
+            editing::set_source_text(
+                request.layer,
+                request.text,
+                handle.state(),
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "updated": true })
+        }
+        "set_translation" => {
+            let request: TranslationRequest = decode(arguments)?;
+            editing::set_translation(
+                request.layer,
+                request.text,
+                handle.state(),
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "updated": true })
+        }
+        "set_typography" => {
+            let request: TypographyRequest = decode(arguments)?;
+            editing::set_typography(
+                request.updates,
+                handle.state(),
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "updated": true })
+        }
+        "export_pages" => {
+            let request: ExportRequest = decode(arguments)?;
+            output::export_pages_to_directory(
+                request.pages,
+                request.format,
+                request.directory,
+                handle.state(),
+                handle.state(),
+            )
+            .await?;
+            json!({ "exported": true })
+        }
+        _ => {
+            return Err(ApiError::bad_request(format!(
+                "unknown Koharu tool {name:?}"
+            )));
+        }
+    };
+    let text = serde_json::to_string_pretty(&structured).map_err(ApiError::internal)?;
+    Ok(json!({
+        "content": [{ "type": "text", "text": text }],
+        "structuredContent": structured,
+        "isError": false
+    }))
+}
+
+fn decode<T: for<'de> Deserialize<'de>>(value: Value) -> std::result::Result<T, ApiError> {
+    serde_json::from_value(value).map_err(ApiError::bad_request)
+}
+
