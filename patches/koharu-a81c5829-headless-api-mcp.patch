+fn write_new_export(
+    target: &Path,
+    write: impl FnOnce(&mut std::fs::File) -> Result<()>,
+) -> Result<()> {
+    let name = target
+        .file_name()
+        .and_then(|name| name.to_str())
+        .context("export target has no valid file name")?;
+    let temporary = target.with_file_name(format!(".{name}.koharu-{}.tmp", Uuid::new_v4()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)
+        .with_context(|| {
+            format!(
+                "failed to create export staging file {}",
+                temporary.display()
+            )
+        })?;
+    let write_result = write(&mut file).and_then(|()| {
+        file.flush()?;
+        file.sync_all()?;
+        Ok(())
+    });
+    drop(file);
+    if let Err(error) = write_result {
+        let _ = std::fs::remove_file(&temporary);
+        return Err(error);
+    }
+    if let Err(error) = std::fs::hard_link(&temporary, target) {
+        let _ = std::fs::remove_file(&temporary);
+        return Err(error).with_context(|| {
+            format!(
+                "failed to publish export without overwriting {}",
+                target.display()
+            )
+        });
+    }
+    std::fs::remove_file(&temporary).with_context(|| {
+        format!(
+            "failed to remove export staging file {}",
+            temporary.display()
+        )
+    })?;
+    Ok(())
+}
