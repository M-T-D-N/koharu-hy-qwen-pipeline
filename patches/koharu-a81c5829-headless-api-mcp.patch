+        request.text,
+        request.typography,
+        request.preserve_source_pixels,
+        handle.state(),
+        handle.state(),
+        handle.state(),
+    )
+    .await
+    {
+        let message = error.message().to_owned();
+        return Err(if message.starts_with("stale review revision:") {
+            ApiError::conflict(message)
+        } else {
+            ApiError::from(error)
+        });
+    }
+    Ok(StatusCode::NO_CONTENT)
