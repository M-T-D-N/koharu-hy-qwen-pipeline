+fn clear_geometry_alpha(image: &mut RgbaImage, points: &[ScenePoint]) -> Result<()> {
+    if points.len() < 3
+        || points
+            .iter()
+            .any(|point| !point.x.is_finite() || !point.y.is_finite())
+    {
+        bail!("source-preservation geometry is invalid");
+    }
+    let signed_double_area: f64 = points
+        .iter()
+        .zip(points.iter().cycle().skip(1))
+        .take(points.len())
+        .map(|(start, end)| start.x * end.y - end.x * start.y)
+        .sum();
+    if signed_double_area.abs() <= f64::EPSILON {
+        bail!("source-preservation geometry is degenerate");
+    }
+    const EDGE_PADDING: f64 = 2.0;
+    const EDGE_PADDING_SQUARED: f64 = EDGE_PADDING * EDGE_PADDING;
+    let min_x = points
+        .iter()
+        .map(|point| point.x)
+        .fold(f64::INFINITY, f64::min);
+    let min_y = points
+        .iter()
+        .map(|point| point.y)
+        .fold(f64::INFINITY, f64::min);
+    let max_x = points
+        .iter()
+        .map(|point| point.x)
+        .fold(f64::NEG_INFINITY, f64::max);
+    let max_y = points
+        .iter()
+        .map(|point| point.y)
+        .fold(f64::NEG_INFINITY, f64::max);
+    let width = i64::from(image.width());
+    let height = i64::from(image.height());
+    let left = ((min_x - EDGE_PADDING).floor() as i64).clamp(0, width);
+    let top = ((min_y - EDGE_PADDING).floor() as i64).clamp(0, height);
+    let right = ((max_x + EDGE_PADDING).ceil() as i64).clamp(0, width);
+    let bottom = ((max_y + EDGE_PADDING).ceil() as i64).clamp(0, height);
+    if left >= right || top >= bottom {
+        bail!("source-preservation geometry is outside the page");
+    }
+    let mut intersects_page = false;
+    for y in top..bottom {
+        for x in left..right {
+            let pixel_x = x as f64 + 0.5;
+            let pixel_y = y as f64 + 0.5;
+            let is_near_edge = points
+                .iter()
+                .zip(points.iter().cycle().skip(1))
+                .take(points.len())
+                .any(|(start, end)| {
+                    squared_distance_to_segment(pixel_x, pixel_y, start, end)
+                        <= EDGE_PADDING_SQUARED
+                });
+            if point_is_inside_polygon(pixel_x, pixel_y, points) || is_near_edge {
+                intersects_page = true;
+                image.get_pixel_mut(x as u32, y as u32)[3] = 0;
+            }
+        }
+    }
+    if !intersects_page {
+        bail!("source-preservation geometry does not cover the page");
+    }
+    Ok(())
+}
+
+fn point_is_inside_polygon(x: f64, y: f64, points: &[ScenePoint]) -> bool {
+    let mut inside = false;
+    for (start, end) in points
+        .iter()
+        .zip(points.iter().cycle().skip(1))
+        .take(points.len())
+    {
+        if (start.y > y) != (end.y > y)
+            && x < (end.x - start.x) * (y - start.y) / (end.y - start.y) + start.x
+        {
+            inside = !inside;
+        }
+    }
+    inside
+}
+
+fn squared_distance_to_segment(x: f64, y: f64, start: &ScenePoint, end: &ScenePoint) -> f64 {
+    let dx = end.x - start.x;
+    let dy = end.y - start.y;
+    let length_squared = dx * dx + dy * dy;
+    if length_squared <= f64::EPSILON {
+        return (x - start.x).powi(2) + (y - start.y).powi(2);
+    }
+    let projection = (((x - start.x) * dx + (y - start.y) * dy) / length_squared).clamp(0.0, 1.0);
+    let nearest_x = start.x + projection * dx;
+    let nearest_y = start.y + projection * dy;
+    (x - nearest_x).powi(2) + (y - nearest_y).powi(2)
+}
