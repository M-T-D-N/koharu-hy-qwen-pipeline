+fn health_value(handle: &AppHandle<Cef>) -> Health {
+    let initialization = handle.state::<Initialization>();
+    let initialization_error = initialization.error();
+    let initialized = initialization.is_ready();
+    Health {
+        status: if initialization_error.is_some() {
+            "failed"
+        } else if initialized {
+            "ok"
+        } else {
+            "starting"
+        },
+        version: env!("CARGO_PKG_VERSION"),
+        initialized,
+        initialization_error,
+    }
+}
