diff --git a/crates/koharu-app/src/api.rs b/crates/koharu-app/src/api.rs
new file mode 100644
index 0000000..f77899f
--- /dev/null
+++ b/crates/koharu-app/src/api.rs
@@ -0,0 +1,870 @@
+use std::{convert::Infallible, path::PathBuf, time::Duration};
+
+use anyhow::{Context as _, Result};
+use axum::{
+    Json, Router,
+    extract::{Path as AxumPath, State},
+    http::StatusCode,
+    response::{
+        Html, IntoResponse, Response,
+        sse::{Event, KeepAlive, Sse},
+    },
+    routing::{get, post},
+};
+use futures::stream;
+use koharu_scene::{EntityId, Revision};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use tauri::{AppHandle, Cef, Manager as _};
+use tokio::sync::broadcast;
+
+use crate::commands::{
+    Error as CommandError,
+    editing::{self, GeometryUpdate, TypographyUpdate},
+    fonts,
+    lifecycle::{self, Initialization},
+    output::{self, ExportFormat},
+    preferences,
+    processing::{self, Job, JobId, Processing},
+    project::{CurrentProject, Page, Project, ProjectInfo, ProjectSummary, Typography},
+};
+
+const MCP_PROTOCOL_VERSION: &str = "2026-07-28";
+const MCP_LEGACY_VERSION: &str = "2025-11-25";
+
+#[derive(Clone, Debug, Serialize)]
+struct Health {
+    status: &'static str,
+    version: &'static str,
+    initialized: bool,
+    initialization_error: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(tag = "event", content = "data", rename_all = "snake_case")]
+enum ApiEvent {
+    Job(Job),
+}
+
+pub(crate) struct ApiEvents {
+    sender: broadcast::Sender<ApiEvent>,
+}
+
+impl Default for ApiEvents {
+    fn default() -> Self {
+        let (sender, _) = broadcast::channel(256);
+        Self { sender }
+    }
+}
+
+impl ApiEvents {
+    pub(crate) fn publish_job(&self, job: Job) {
+        let _ = self.sender.send(ApiEvent::Job(job));
+    }
+}
+
+#[derive(Debug)]
+struct ApiError {
+    status: StatusCode,
+    message: String,
+}
+
+impl ApiError {
+    fn bad_request(error: impl std::fmt::Display) -> Self {
+        Self {
+            status: StatusCode::BAD_REQUEST,
+            message: error.to_string(),
+        }
+    }
+
+    fn internal(error: impl std::fmt::Display) -> Self {
+        Self {
+            status: StatusCode::INTERNAL_SERVER_ERROR,
+            message: error.to_string(),
+        }
+    }
+
+    fn conflict(error: impl std::fmt::Display) -> Self {
+        Self {
+            status: StatusCode::CONFLICT,
+            message: error.to_string(),
+        }
+    }
+}
+
+impl From<CommandError> for ApiError {
+    fn from(error: CommandError) -> Self {
+        Self::bad_request(error.message())
+    }
+}
+
+impl IntoResponse for ApiError {
+    fn into_response(self) -> Response {
+        (self.status, Json(json!({ "error": self.message }))).into_response()
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct NameRequest {
+    name: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct ImportRequest {
+    paths: Vec<PathBuf>,
+}
+
+#[derive(Debug, Deserialize)]
+struct PreferencesRequest {
+    pipeline: koharu_pipeline::PipelineConfig,
+    providers: preferences::ProviderPreferences,
+    typesetting: koharu_renderer::TypesettingConfig,
+}
+
+#[derive(Debug, Deserialize)]
+struct SelectPageRequest {
+    page: EntityId,
+}
+
+#[derive(Debug, Deserialize)]
+struct SourceTextRequest {
+    layer: EntityId,
+    text: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct TranslationRequest {
+    layer: EntityId,
+    text: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ReviewDecisionRequest {
+    expected_revision: Revision,
+    layer: EntityId,
+    text: Option<String>,
+    typography: Option<Typography>,
+    #[serde(default)]
+    preserve_source_pixels: bool,
+}
+
+#[derive(Debug, Deserialize)]
+struct TypographyRequest {
+    updates: Vec<TypographyUpdate>,
+}
+
+#[derive(Debug, Deserialize)]
+struct GeometryRequest {
+    updates: Vec<GeometryUpdate>,
+}
+
+#[derive(Debug, Deserialize)]
+struct DeleteLayersRequest {
+    layers: Vec<EntityId>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ProcessRequest {
+    #[serde(default)]
+    scope: koharu_pipeline::Scope,
+    #[serde(default)]
+    operation: koharu_pipeline::Operation,
+}
+
+#[derive(Debug, Deserialize)]
+struct StopRequest {
+    job: JobId,
+}
+
+#[derive(Debug, Deserialize)]
+struct ExportRequest {
+    directory: PathBuf,
+    #[serde(default)]
+    pages: Vec<EntityId>,
+    format: ExportFormat,
+}
