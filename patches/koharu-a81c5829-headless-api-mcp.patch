+pub(crate) async fn serve(handle: AppHandle<Cef>, listener: tokio::net::TcpListener) -> Result<()> {
+    let app = Router::new()
+        .route("/", get(index))
+        .route("/api/v1/health", get(health))
+        .route("/api/v1/events", get(events))
+        .route("/api/v1/projects", get(list_projects).post(create_project))
+        .route("/api/v1/projects/open", post(open_project))
+        .route("/api/v1/projects/close", post(close_project))
+        .route("/api/v1/project", get(current_project))
+        .route("/api/v1/pages", get(pages).post(import_pages))
+        .route("/api/v1/pages/select", post(select_page))
+        .route("/api/v1/pages/{page}", get(page_scene))
+        .route("/api/v1/text/source", post(set_source_text))
+        .route("/api/v1/text/translation", post(set_translation))
+        .route("/api/v1/review/decision", post(apply_review_decision))
+        .route("/api/v1/text/typography", post(set_typography))
+        .route("/api/v1/text/geometry", post(set_geometry))
+        .route("/api/v1/layers/delete", post(delete_layers))
+        .route("/api/v1/pipeline", post(start_pipeline))
+        .route("/api/v1/pipeline/stop", post(stop_pipeline))
+        .route("/api/v1/jobs", get(jobs))
+        .route("/api/v1/fonts", get(available_fonts))
+        .route(
+            "/api/v1/preferences",
+            get(get_preferences).post(save_preferences),
+        )
+        .route("/api/v1/translation/models", get(translation_models))
+        .route("/api/v1/export", post(export_pages))
+        .route("/mcp", post(mcp))
+        .with_state(handle);
+    axum::serve(listener, app).await?;
+    Ok(())
+}
